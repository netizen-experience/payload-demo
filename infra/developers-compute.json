{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "rds:Describe*",
        "lambda:Get*",
        "lambda:List*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "cloudfront:DescribeKeyValueStore",
        "logs:Describe*",
        "logs:ListTagsForResource",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRole*",
        "iam:ListAttachedRolePolicies",
        "route53:Get*",
        "route53:List*",
        "acm:Describe*",
        "acm:List*",
        "servicediscovery:Get*",
        "servicediscovery:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2NetworkingCreateTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateRoute",
        "ec2:CreateSecurityGroup",
        "ec2:CreateInternetGateway",
        "ec2:CreateVpcEndpoint",
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/sst:app": "payload-demo",
          "aws:RequestTag/sst:stage": "staging"
        }
      }
    },
    {
      "Sid": "Ec2NetworkingModifyExistingTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpc",
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:DeleteRoute",
        "ec2:ReplaceRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:ModifyVpcEndpoint",
        "ec2:DeleteVpcEndpoints",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/sst:app": "payload-demo",
          "aws:ResourceTag/sst:stage": "staging"
        }
      }
    },
    {
      "Sid": "RdsManageTagged",
      "Effect": "Allow",
      "Action": "rds:*",
      "Resource": [
        "arn:aws:rds:ap-southeast-1:263078047633:cluster:payload-demo-staging-*",
        "arn:aws:rds:ap-southeast-1:263078047633:db:payload-demo-staging-*",
        "arn:aws:rds:ap-southeast-1:263078047633:subgrp:payload-demo-staging-*",
        "arn:aws:rds:ap-southeast-1:263078047633:cluster-pg:payload-demo-staging-*",
        "arn:aws:rds:ap-southeast-1:263078047633:pg:payload-demo-staging-*"
      ]
    },
    {
      "Sid": "LambdaManageTagged",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:CreateEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:PutFunctionConcurrency",
        "lambda:InvokeFunction"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/sst:app": "payload-demo",
          "aws:ResourceTag/sst:stage": "staging"
        }
      }
    },
    {
      "Sid": "IamPassRoleForLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::263078047633:role/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com",
          "aws:ResourceTag/sst:app": "payload-demo",
          "aws:ResourceTag/sst:stage": "staging"
        }
      }
    },
    {
      "Sid": "IamRoleLifecycleTagged",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::263078047633:role/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/sst:app": "payload-demo",
          "aws:ResourceTag/sst:stage": "staging"
        }
      }
    },
    {
      "Sid": "CloudFrontDistributionCreate",
      "Effect": "Allow",
      "Action": "cloudfront:CreateDistribution",
      "Resource": "*"
    },
    {
      "Sid": "CloudFrontDistributionManageKnown",
      "Effect": "Allow",
      "Action": [
        "cloudfront:TagResource",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:CreateInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::263078047633:distribution/E2ML405UITKU2W"
    },
    {
      "Sid": "CloudFrontFunctionManageByName",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:DeleteFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:PublishFunction",
        "cloudfront:TagResource"
      ],
      "Resource": "arn:aws:cloudfront::263078047633:function/payload-demo-staging-*"
    },
    {
      "Sid": "CloudFrontKeyValueStoreBroad",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateKeyValueStore",
        "cloudfront:DeleteKeyValueStore",
        "cloudfront:UpdateKeyValueStore",
        "cloudfront:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsForFunctions",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:ap-southeast-1:263078047633:log-group:/aws/lambda/payload-demo-staging-*"
    },
    {
      "Sid": "Route53RecordsForPayloadDemoZone",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets", "route53:ChangeTagsForResource"],
      "Resource": "arn:aws:route53:::hostedzone/Z06693953EJ4NP2ZAD3IE"
    },
    {
      "Sid": "AcmCertificateLifecycle",
      "Effect": "Allow",
      "Action": ["acm:RequestCertificate", "acm:DeleteCertificate", "acm:AddTagsToCertificate"],
      "Resource": "*"
    }
  ]
}
