# Database connection string (see docker-compose.yml for local Postgres service)
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/payload_demo

# Or use a MongoDB connection string
#DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# S3 bucket for media storage (private; served via Payload's /api/media/file proxy).
# Credentials come from the AWS SDK default provider chain (e.g. AWS_PROFILE for local
# dev via SSO, or an IAM role in production) — no static access keys needed.
S3_BUCKET=your-bucket-name
S3_REGION=your-bucket-region

# Only needed for `npm run test:e2e:staging` (smoke tests against a deployed environment,
# e.g. the Phase 3 SST stack) — not used by the app itself.
#STAGING_URL=https://xxxx.cloudfront.net
#STAGING_TEST_EMAIL=your-test-admin@example.com
#STAGING_TEST_PASSWORD=your-test-admin-password
